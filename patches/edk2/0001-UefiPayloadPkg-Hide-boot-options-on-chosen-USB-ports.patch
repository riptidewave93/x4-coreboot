index 0000000..d1fd63e
--- /dev/null
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/BootOptionFilter.c
@@ -0,0 +1,171 @@
+/** @file
+  Drop boot options for devices on hidden root-hub ports of one USB controller.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "PlatformBootManager.h"
+#include <Protocol/PlatformBootManager.h>
+
+/**
+  Return TRUE if DevicePath is PciRoot()/Pci(Dev,Fn)/USB(Port,...) with Pci(Dev,Fn)
+  matching PcdBootHiddenUsbPci and Port set in PcdBootHiddenUsbPorts.
+**/
+STATIC
+BOOLEAN
+IsOnHiddenUsbPort (
+  IN EFI_DEVICE_PATH_PROTOCOL  *DevicePath
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Node;
+  PCI_DEVICE_PATH           *Pci;
+  USB_DEVICE_PATH           *Usb;
+  UINT16                    PciAddr;
+
+  Node = DevicePath;
+  if ((Node == NULL) || IsDevicePathEnd (Node) ||
+      (DevicePathType (Node) != ACPI_DEVICE_PATH) || (DevicePathSubType (Node) != ACPI_DP))
+  {
+    return FALSE;
+  }
+
+  Node = NextDevicePathNode (Node);
+  if (IsDevicePathEnd (Node) ||
+      (DevicePathType (Node) != HARDWARE_DEVICE_PATH) || (DevicePathSubType (Node) != HW_PCI_DP))
+  {
+    return FALSE;
+  }
+
+  Pci     = (PCI_DEVICE_PATH *)Node;
+  PciAddr = FixedPcdGet16 (PcdBootHiddenUsbPci);
+  if ((Pci->Device != (PciAddr >> 8)) || (Pci->Function != (PciAddr & 0xFF))) {
+    return FALSE;
+  }
+
+  Node = NextDevicePathNode (Node);
+  if (IsDevicePathEnd (Node) ||
+      (DevicePathType (Node) != MESSAGING_DEVICE_PATH) || (DevicePathSubType (Node) != MSG_USB_DP))
+  {
+    return FALSE;
+  }
+
+  Usb = (USB_DEVICE_PATH *)Node;
+  return (Usb->ParentPortNumber < 32) &&
+         ((FixedPcdGet32 (PcdBootHiddenUsbPorts) & (1U << Usb->ParentPortNumber)) != 0);
+}
+
+/**
+  Delete NV boot options on hidden ports, including ones not created by BDS.
+**/
+STATIC
+VOID
+DeleteHiddenNvBootOptions (
+  VOID
+  )
+{
+  EFI_BOOT_MANAGER_LOAD_OPTION  *NvOptions;
+  UINTN                         NvCount;
+  UINTN                         Index;
+
+  NvOptions = EfiBootManagerGetLoadOptions (&NvCount, LoadOptionTypeBoot);
+  for (Index = 0; Index < NvCount; Index++) {
+    if (IsOnHiddenUsbPort (NvOptions[Index].FilePath)) {
+      DEBUG ((DEBUG_INFO, "%a: deleting Boot%04x %s\n", __func__, NvOptions[Index].OptionNumber, NvOptions[Index].Description));
+      EfiBootManagerDeleteLoadOptionVariable (NvOptions[Index].OptionNumber, LoadOptionTypeBoot);
+    }
+  }
+
+  if (NvOptions != NULL) {
+    EfiBootManagerFreeLoadOptions (NvOptions, NvCount);
+  }
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+RefreshAllBootOptions (
+  IN  CONST EFI_BOOT_MANAGER_LOAD_OPTION  *BootOptions,
+  IN  CONST UINTN                         BootOptionsCount,
+  OUT       EFI_BOOT_MANAGER_LOAD_OPTION  **UpdatedBootOptions,
+  OUT       UINTN                         *UpdatedBootOptionsCount
+  )
+{
+  EFI_BOOT_MANAGER_LOAD_OPTION  *Kept;
+  UINTN                         KeptCount;
+  UINTN                         Index;
+  EFI_STATUS                    Status;
+
+  if ((UpdatedBootOptions == NULL) || (UpdatedBootOptionsCount == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  DeleteHiddenNvBootOptions ();
+
+  if (BootOptionsCount == 0) {
+    return EFI_UNSUPPORTED;
+  }
+
+  Kept = AllocateZeroPool (BootOptionsCount * sizeof (*Kept));
+  if (Kept == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  KeptCount = 0;
+  for (Index = 0; Index < BootOptionsCount; Index++) {
+    if (IsOnHiddenUsbPort (BootOptions[Index].FilePath)) {
+      DEBUG ((DEBUG_INFO, "%a: hiding %s\n", __func__, BootOptions[Index].Description));
+      continue;
+    }
+
+    Status = EfiBootManagerInitializeLoadOption (
+               &Kept[KeptCount],
+               BootOptions[Index].OptionNumber,
+               BootOptions[Index].OptionType,
+               BootOptions[Index].Attributes,
+               BootOptions[Index].Description,
+               BootOptions[Index].FilePath,
+               BootOptions[Index].OptionalData,
+               BootOptions[Index].OptionalDataSize
+               );
+    if (EFI_ERROR (Status)) {
+      EfiBootManagerFreeLoadOptions (Kept, KeptCount);
+      return Status;
+    }
+
+    KeptCount++;
+  }
+
+  *UpdatedBootOptions      = Kept;
+  *UpdatedBootOptionsCount = KeptCount;
+  return EFI_SUCCESS;
+}
+
+STATIC EDKII_PLATFORM_BOOT_MANAGER_PROTOCOL  mBootOptionFilter = {
+  EDKII_PLATFORM_BOOT_MANAGER_PROTOCOL_REVISION,
+  RefreshAllBootOptions
+};
+
+/**
+  Install the boot option filter if any USB port is hidden.
+**/
+VOID
+PlatformInstallBootOptionFilter (
+  VOID
+  )
+{
+  EFI_HANDLE  Handle;
+  EFI_STATUS  Status;
+
+  if (FixedPcdGet32 (PcdBootHiddenUsbPorts) == 0) {
+    return;
+  }
+
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle,
+                  &gEdkiiPlatformBootManagerProtocolGuid,
+                  &mBootOptionFilter,
+                  NULL
+                  );
+  ASSERT_EFI_ERROR (Status);
+}
