diff --git a/UefiPayloadPkg/NetworkBootPolicyDxe/NetworkBootPolicyDxe.c b/UefiPayloadPkg/NetworkBootPolicyDxe/NetworkBootPolicyDxe.c
new file mode 100644
index 0000000..715add3
--- /dev/null
+++ b/UefiPayloadPkg/NetworkBootPolicyDxe/NetworkBootPolicyDxe.c
@@ -0,0 +1,61 @@
+/** @file
+  Install gNetworkBootPolicyGuid unless the CFR option "network_stack" is off.
+
+  The FV's bootloader-supplied NIC driver depends on that protocol, so with the
+  option off no NIC driver runs and the network stack has nothing to bind to.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+#include <Library/CfrHelpersLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+
+#define NETWORK_STACK_OPTION    "network_stack"
+#define NETWORK_STACK_VARIABLE  L"network_stack"
+
+STATIC
+BOOLEAN
+NetworkStackEnabled (
+  VOID
+  )
+{
+  UINT32      Value;
+  UINTN       Size;
+  VOID        *Default;
+  EFI_STATUS  Status;
+
+  Size   = sizeof (Value);
+  Status = gRT->GetVariable (NETWORK_STACK_VARIABLE, &gEficorebootNvDataGuid, NULL, &Size, &Value);
+  if (!EFI_ERROR (Status) && (Size == sizeof (Value))) {
+    return Value != 0;
+  }
+
+  //
+  // Not stored yet: use the CFR default
+  //
+  Status = CfrOptionGetDefaultValue (NULL, NETWORK_STACK_OPTION, &Default, NULL);
+  if (!EFI_ERROR (Status)) {
+    return *(UINT32 *)Default != 0;
+  }
+
+  //
+  // The bootloader has no such option
+  //
+  return TRUE;
+}
+
+EFI_STATUS
+EFIAPI
+NetworkBootPolicyEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  if (!NetworkStackEnabled ()) {
+    return EFI_SUCCESS;
+  }
+
+  return gBS->InstallMultipleProtocolInterfaces (&ImageHandle, &gNetworkBootPolicyGuid, NULL, NULL);
+}
