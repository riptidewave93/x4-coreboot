From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Sat, 24 Oct 2026 10:34:39 -0500
Subject: [PATCH 02/15] drivers/intel/fsp2_0/ppi: Wait for the APs in the MP
 services PPI

The PEI MP services are blocking: StartupAllAPs(), StartupThisAP() and
StartupAllCPUs() return only after the APs have run the procedure or
the timeout has expired. coreboot returned as soon as the APs had
picked up the procedure, so FSP carried on while APs were still
running it, and serial runs could overlap.

Export mp_run_on_aps_and_wait_for_complete(), add
mp_run_on_all_aps_and_wait_for_complete() for parallel and serial
runs, and use them in the MP services PPI.

[Generated by Claude, an AI model by Anthropic.]

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 src/cpu/x86/mp_init.c                         | 29 +++++++++++++++----
 src/drivers/intel/fsp2_0/ppi/mp_service_ppi.c |  6 ++--
 src/include/cpu/x86/mp.h                      |  9 ++++++
 3 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/src/cpu/x86/mp_init.c b/src/cpu/x86/mp_init.c
index 6949a6a3..83432b93 100644
--- a/src/cpu/x86/mp_init.c
+++ b/src/cpu/x86/mp_init.c
@@ -1047,7 +1047,7 @@ enum cb_err mp_run_on_aps(void (*func)(void *), void *arg, int logical_cpu_num,
 	return run_ap_work(&lcb, expire_us, false);
 }
 
-static enum cb_err mp_run_on_aps_and_wait_for_complete(void (*func)(void *), void *arg,
+enum cb_err mp_run_on_aps_and_wait_for_complete(void (*func)(void *), void *arg,
 		int logical_cpu_num, long expire_us)
 {
 	struct mp_callback lcb = { .func = func, .arg = arg,
@@ -1055,13 +1055,16 @@ static enum cb_err mp_run_on_aps_and_wait_for_complete(void (*func)(void *), voi
 	return run_ap_work(&lcb, expire_us, true);
 }
 
-enum cb_err mp_run_on_all_aps(void (*func)(void *), void *arg, long expire_us,
-			      bool run_parallel)
+static enum cb_err run_on_all_aps(void (*func)(void *), void *arg, long expire_us,
+				  bool run_parallel, bool wait_ap_finish)
 {
 	int ap_index, bsp_index;
 
-	if (run_parallel)
-		return mp_run_on_aps(func, arg, MP_RUN_ON_ALL_CPUS, expire_us);
+	if (run_parallel) {
+		struct mp_callback lcb = { .func = func, .arg = arg,
+					.logical_cpu_number = MP_RUN_ON_ALL_CPUS};
+		return run_ap_work(&lcb, expire_us, wait_ap_finish);
+	}
 
 	bsp_index = cpu_index();
 
@@ -1071,13 +1074,27 @@ enum cb_err mp_run_on_all_aps(void (*func)(void *), void *arg, long expire_us,
 		/* skip if BSP */
 		if (ap_index == bsp_index)
 			continue;
-		if (mp_run_on_aps(func, arg, ap_index, expire_us) != CB_SUCCESS)
+		struct mp_callback lcb = { .func = func, .arg = arg,
+					.logical_cpu_number = ap_index};
+		if (run_ap_work(&lcb, expire_us, wait_ap_finish) != CB_SUCCESS)
 			return CB_ERR;
 	}
 
 	return CB_SUCCESS;
 }
 
+enum cb_err mp_run_on_all_aps(void (*func)(void *), void *arg, long expire_us,
+			      bool run_parallel)
+{
+	return run_on_all_aps(func, arg, expire_us, run_parallel, false);
+}
+
+enum cb_err mp_run_on_all_aps_and_wait_for_complete(void (*func)(void *), void *arg,
+		long expire_us, bool run_parallel)
+{
+	return run_on_all_aps(func, arg, expire_us, run_parallel, true);
+}
+
 enum cb_err mp_run_on_all_cpus(void (*func)(void *), void *arg)
 {
 	/* Run on BSP first. */
diff --git a/src/drivers/intel/fsp2_0/ppi/mp_service_ppi.c b/src/drivers/intel/fsp2_0/ppi/mp_service_ppi.c
index ccc6bdbf..2b4c9084 100644
--- a/src/drivers/intel/fsp2_0/ppi/mp_service_ppi.c
+++ b/src/drivers/intel/fsp2_0/ppi/mp_service_ppi.c
@@ -102,7 +102,7 @@ efi_return_status_t mp_startup_all_aps(efi_ap_procedure procedure,
 	if (procedure == NULL)
 		return FSP_INVALID_PARAMETER;
 
-	if (mp_run_on_all_aps((void *)efi_ap_procedure_caller, &params,
+	if (mp_run_on_all_aps_and_wait_for_complete((void *)efi_ap_procedure_caller, &params,
 			      timeout_usec, !run_serial) != CB_SUCCESS) {
 		printk(BIOS_DEBUG, "%s: Exit with Failure\n", __func__);
 		return FSP_NOT_STARTED;
@@ -142,7 +142,7 @@ efi_return_status_t mp_startup_all_cpus(efi_ap_procedure procedure,
 	 * due to lack of acquiring a spin lock while accessing common data structure in
 	 * multiprocessor environment.
 	 */
-	if (mp_run_on_all_aps((void *)efi_ap_procedure_caller,
+	if (mp_run_on_all_aps_and_wait_for_complete((void *)efi_ap_procedure_caller,
 			      &params, timeout_usec, false) != CB_SUCCESS) {
 		printk(BIOS_DEBUG, "%s: Exit with Failure\n", __func__);
 		return FSP_NOT_STARTED;
@@ -171,7 +171,7 @@ efi_return_status_t mp_startup_this_ap(efi_ap_procedure procedure,
 	if (procedure == NULL)
 		return FSP_INVALID_PARAMETER;
 
-	if (mp_run_on_aps((void *)efi_ap_procedure_caller, &params,
+	if (mp_run_on_aps_and_wait_for_complete((void *)efi_ap_procedure_caller, &params,
 			processor_number, timeout_usec) != CB_SUCCESS) {
 		printk(BIOS_DEBUG, "%s: Exit with Failure\n", __func__);
 		return FSP_NOT_STARTED;
diff --git a/src/include/cpu/x86/mp.h b/src/include/cpu/x86/mp.h
index ec4297e1..95744de4 100644
--- a/src/include/cpu/x86/mp.h
+++ b/src/include/cpu/x86/mp.h
@@ -122,6 +122,15 @@ enum cb_err mp_run_on_aps(void (*func)(void *), void *arg, int logical_cpu_num,
 enum cb_err mp_run_on_all_aps(void (*func)(void *), void *arg, long expire_us,
 			      bool run_parallel);
 
+/*
+ * Like mp_run_on_aps() and mp_run_on_all_aps(), but return only once the APs
+ * have finished func, not just accepted it.
+ */
+enum cb_err mp_run_on_aps_and_wait_for_complete(void (*func)(void *), void *arg,
+		int logical_cpu_num, long expire_us);
+enum cb_err mp_run_on_all_aps_and_wait_for_complete(void (*func)(void *), void *arg,
+		long expire_us, bool run_parallel);
+
 /* Like mp_run_on_aps() but also runs func on BSP. */
 enum cb_err mp_run_on_all_cpus(void (*func)(void *), void *arg);
 
