From: Chris Blake <chrisrblake93@gmail.com>
Date: Sat, 24 Oct 2026 10:34:43 -0500
Subject: [PATCH 07/15] mb/radxa/x4: Add a flash layout matching the descriptor

The descriptor puts the BIOS region at 0x600000-0xffffff (10MB), but
the default layout used only the top 4MB, so writing the BIOS region
left its lower 6MB stale.

Add board.fmd: MRC cache, SMMSTORE and FMAP at the bottom of the BIOS
region, CBFS above them. The MRC cache gets 128KB, enough for two
copies of FSP-M's training data of about 62KB. SMMSTORE gets 1MB, which
leaves 448KB for UEFI variables.

The descriptor sets a 256KB Top Swap block: with the Top Swap strap
set, the CPU starts from 0xf80000-0xfbffff instead of the top 256KB.
Fill that block with an empty raw CBFS file at a fixed position, so no
other CBFS file lands in it.

[Generated by Claude, an AI model by Anthropic.]

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 src/mainboard/radxa/x4/Kconfig     |  6 ++++++
 src/mainboard/radxa/x4/Makefile.mk | 10 ++++++++++
 src/mainboard/radxa/x4/board.fmd   | 12 ++++++++++++
 3 files changed, 28 insertions(+)
 create mode 100644 src/mainboard/radxa/x4/board.fmd

diff --git a/src/mainboard/radxa/x4/Kconfig b/src/mainboard/radxa/x4/Kconfig
index 00e9438c..fbfefbc8 100644
--- a/src/mainboard/radxa/x4/Kconfig
+++ b/src/mainboard/radxa/x4/Kconfig
@@ -21,6 +21,12 @@ config BOARD_SPECIFIC_OPTIONS
 config MAINBOARD_DIR
 	default "radxa/x4"
 
+config FMDFILE
+	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/board.fmd"
+
+config SMMSTORE_SIZE
+	default 0x100000
+
 config MAINBOARD_PART_NUMBER
 	default "X4"
 
diff --git a/src/mainboard/radxa/x4/Makefile.mk b/src/mainboard/radxa/x4/Makefile.mk
index 88ed9594..7b9c4bd3 100644
--- a/src/mainboard/radxa/x4/Makefile.mk
+++ b/src/mainboard/radxa/x4/Makefile.mk
@@ -6,3 +6,13 @@ subdirs-$(CONFIG_HAVE_SPD_IN_CBFS) += spd
 bootblock-y += bootblock.c
 ramstage-y += ramstage.c
 romstage-y += romstage.c
+
+# The PCH runs the reset vector from this block when Top Swap is set: no CBFS files there
+cbfs-files-y += recovery-bootblock
+recovery-bootblock-file := $(obj)/mainboard/$(MAINBOARDDIR)/recovery-bootblock.bin
+recovery-bootblock-type := raw
+recovery-bootblock-position := 0xfff80000
+
+$(obj)/mainboard/$(MAINBOARDDIR)/recovery-bootblock.bin:
+	mkdir -p $(dir $@)
+	dd if=/dev/zero bs=4096 count=64 2>/dev/null | tr '\000' '\377' > $@
diff --git a/src/mainboard/radxa/x4/board.fmd b/src/mainboard/radxa/x4/board.fmd
new file mode 100644
index 00000000..7a6756a6
--- /dev/null
+++ b/src/mainboard/radxa/x4/board.fmd
@@ -0,0 +1,12 @@
+FLASH 16M {
+	SI_ALL 6M {
+		SI_DESC 4K
+		SI_ME 0x45b000
+	}
+	SI_BIOS 10M {
+		RW_MRC_CACHE 128K
+		SMMSTORE 1M
+		FMAP 4K
+		COREBOOT(CBFS)
+	}
+}
