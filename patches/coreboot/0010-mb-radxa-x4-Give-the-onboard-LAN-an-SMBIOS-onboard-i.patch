Date: Sat, 24 Oct 2026 10:34:45 -0500
Subject: [PATCH 10/15] mb/radxa/x4: Give the onboard LAN an SMBIOS onboard
 index

Linux names a NIC without a firmware index after its PCI bus (enp2s0).
With Wi-Fi turned off, root port 4 is gone and the I226-V moves from
bus 2 to bus 1, which renames it. Add an SMBIOS type 41 entry for the
device behind root port 7, with instance 1 and the bus found at
runtime, so systemd names it eno1 on every boot.

[Generated by Claude, an AI model by Anthropic.]

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 src/mainboard/radxa/x4/ramstage.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/mainboard/radxa/x4/ramstage.c b/src/mainboard/radxa/x4/ramstage.c
index 894d2a51..bffaff3c 100644
--- a/src/mainboard/radxa/x4/ramstage.c
+++ b/src/mainboard/radxa/x4/ramstage.c
@@ -2,7 +2,9 @@
 
 #include <console/console.h>
 #include <device/device.h>
+#include <device/pci_def.h>
 #include <option.h>
+#include <smbios.h>
 #include <soc/ramstage.h>
 #include <static.h>
 #include "gpio.h"
@@ -33,8 +35,30 @@ static void mainboard_init(void *chip_info)
 	}
 }
 
+/* An onboard index makes Linux name the LAN eno1, whatever its bus number */
+static int mainboard_smbios_data(struct device *dev, int *handle, unsigned long *current)
+{
+	const struct device *rp = DEV_PTR(pcie_rp7);
+	const struct device *nic;
+
+	if (!rp->enabled || !rp->downstream)
+		return 0;
+	nic = pcidev_path_behind(rp->downstream, PCI_DEVFN(0, 0));
+	if (!nic || !nic->enabled)
+		return 0;
+	return smbios_write_type41(current, handle, "Onboard LAN", 1, 0,
+				   rp->downstream->secondary, 0, 0,
+				   SMBIOS_DEVICE_TYPE_ETHERNET);
+}
+
+static void mainboard_enable(struct device *dev)
+{
+	dev->ops->get_smbios_data = mainboard_smbios_data;
+}
+
 struct chip_operations mainboard_ops = {
 	.init = mainboard_init,
+	.enable_dev = mainboard_enable,
 };
 
 void mainboard_silicon_init_params(FSP_S_CONFIG *params)
