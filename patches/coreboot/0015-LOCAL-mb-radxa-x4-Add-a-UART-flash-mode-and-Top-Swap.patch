diff --git a/src/mainboard/radxa/x4/topswap.S b/src/mainboard/radxa/x4/topswap.S
new file mode 100644
index 00000000..38855bc0
--- /dev/null
+++ b/src/mainboard/radxa/x4/topswap.S
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Set BUC.TS and reset. Setting the bit swaps the block this bootblock runs from, so
+ * uart_flash.c copies this code into CAR and calls it there. It writes no flash.
+ * In: %eax = wanted bit (0 or 1), %edx = BUC address. Out: %eax = BUC, if unchanged.
+ */
+
+.code32
+.section .rodata.x4_topswap_stub, "a", @progbits
+.global x4_topswap_stub, x4_topswap_stub_end
+
+x4_topswap_stub:
+	movl	(%edx), %ecx
+	pushl	%ecx
+	andl	$0xfffffffe, %ecx
+	orl	%eax, %ecx
+	movl	%ecx, (%edx)
+	movl	(%edx), %eax		/* read back: completes the posted write */
+	popl	%ecx
+	xorl	%eax, %ecx
+	testb	$1, %cl
+	jnz	1f
+	ret				/* unchanged: the mapping is the same, return to flash */
+1:	movw	$0xcf9, %dx		/* changed: full reset */
+	movb	$0x0a, %al
+	outb	%al, %dx
+	movb	$0x0e, %al
+	outb	%al, %dx
+2:	hlt
+	jmp	2b
+x4_topswap_stub_end:
diff --git a/src/mainboard/radxa/x4/uart_flash.c b/src/mainboard/radxa/x4/uart_flash.c
new file mode 100644
index 00000000..045757a1
--- /dev/null
+++ b/src/mainboard/radxa/x4/uart_flash.c
@@ -0,0 +1,266 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* X4 UART flash mode over UART0, in the normal bootblock and in the Top Swap recovery bootblock. */
+
+#include <boot_device.h>
+#include <cf9_reset.h>
+#include <commonlib/region.h>
+#include <console/console.h>
+#include <console/uart.h>
+#include <cpu/x86/tsc.h>
+#include <delay.h>
+#include <device/mmio.h>
+#include <device/pci_ops.h>
+#include <fmap_config.h>
+#include <intelblocks/pcr.h>
+#include <soc/pcr_ids.h>
+#include <string.h>
+#include <symbols.h>
+#include <version.h>
+#include "uart_flash.h"
+#include "uart_flash_proto.h"
+
+#define WINDOW_MS	2000
+#define IDLE_MS		(10 * 60 * 1000)
+
+#define PCR_RTC_BUC	0x3414
+#define  BUC_TS		(1 << 0)
+#define SPI_BC		0xdc	/* D31:F5 BIOS control */
+#define  BC_TSS		(1 << 4)
+
+_Static_assert(CONFIG_ROM_SIZE == UF_FLASH_SIZE, "flash size");
+_Static_assert(FMAP_SECTION_SI_DESC_START == 0 && FMAP_SECTION_SI_DESC_SIZE == UF_ME_START, "desc");
+_Static_assert(FMAP_SECTION_SI_ME_START == UF_ME_START &&
+	       FMAP_SECTION_SI_ME_START + FMAP_SECTION_SI_ME_SIZE == UF_REGION9_START, "ME");
+_Static_assert(FMAP_SECTION_SI_BIOS_START == UF_BIOS_START &&
+	       FMAP_SECTION_SI_BIOS_SIZE == UF_FLASH_SIZE - UF_BIOS_START, "SI_BIOS");
+_Static_assert(FMAP_SECTION_RW_MRC_CACHE_START == UF_BIOS_START &&
+	       FMAP_SECTION_RW_MRC_CACHE_SIZE == UF_SMMSTORE_START - UF_BIOS_START, "MRC");
+_Static_assert(FMAP_SECTION_SMMSTORE_START == UF_SMMSTORE_START &&
+	       FMAP_SECTION_SMMSTORE_SIZE == UF_FMAP_START - UF_SMMSTORE_START, "SMMSTORE");
+_Static_assert(FMAP_OFFSET == UF_FMAP_START &&
+	       FMAP_SECTION_FMAP_SIZE == UF_CBFS_START - UF_FMAP_START, "FMAP");
+_Static_assert(FMAP_SECTION_COREBOOT_START == UF_CBFS_START &&
+	       FMAP_SECTION_COREBOOT_SIZE == UF_FLASH_SIZE - UF_CBFS_START, "COREBOOT");
+
+extern const uint8_t x4_topswap_stub[], x4_topswap_stub_end[];
+static uint8_t topswap_buf[64] __aligned(16);	/* .bss, so in CAR */
+
+#define UART_RBR	0
+#define UART_THR	0
+#define UART_LSR	5
+#define LSR_DR		0x01
+#define LSR_THRE	0x20
+#define LSR_TEMT	0x40
+
+static void *uart_base;
+static const struct region_device *flash;
+static bool written;
+
+static uint8_t uart_rd(int reg)
+{
+	if (CONFIG(DRIVERS_UART_8250MEM_32))
+		return read32(uart_base + 4 * reg) & 0xff;
+	return read8(uart_base + reg);
+}
+
+static void uart_wr(int reg, uint8_t v)
+{
+	if (CONFIG(DRIVERS_UART_8250MEM_32))
+		write32(uart_base + 4 * reg, v);
+	else
+		write8(uart_base + reg, v);
+}
+
+static int ops_rx(void)
+{
+	if (!(uart_rd(UART_LSR) & LSR_DR))
+		return -1;
+	return uart_rd(UART_RBR);
+}
+
+static void ops_tx(uint8_t b)
+{
+	for (int i = 0; i < 100000 && !(uart_rd(UART_LSR) & LSR_THRE); i++)
+		udelay(1);
+	uart_wr(UART_THR, b);
+}
+
+/* timer_monotonic_get() drops the sub-microsecond remainder per call: tight loops run slow */
+static uint64_t ops_now_us(void)
+{
+	static unsigned long mhz;
+
+	if (!mhz)
+		mhz = tsc_freq_mhz();
+	return rdtscll() / mhz;
+}
+
+static int ops_read(uint32_t off, void *buf, size_t len)
+{
+	return rdev_readat(flash, buf, off, len) == len ? 0 : -1;
+}
+
+/* The bootblock runs from the flash being erased: pull all of it into the cache first */
+static void cache_bootblock(void)
+{
+	const size_t size = (uintptr_t)_ebootblock - (uintptr_t)_bootblock;
+	static bool done;
+
+	for (size_t i = 0; !done && i < size; i += 64)
+		(void)read8(_bootblock + i);
+	done = true;
+}
+
+static int ops_erase(uint32_t off, size_t len)
+{
+	cache_bootblock();
+	return rdev_eraseat(flash, off, len) == len ? 0 : -1;
+}
+
+static int ops_write(uint32_t off, const void *buf, size_t len)
+{
+	return rdev_writeat(flash, buf, off, len) == len ? 0 : -1;
+}
+
+static void drain_uart(void)
+{
+	if (!uart_base)
+		return;
+	for (int i = 0; i < 100000 && !(uart_rd(UART_LSR) & LSR_TEMT); i++)
+		udelay(1);
+}
+
+static void ops_reset(void)
+{
+	drain_uart();
+	full_reset();
+}
+
+/* Changing BUC.TS swaps the block this code runs from: the switch runs from CAR */
+static void ops_topswap(int on)
+{
+	const size_t len = x4_topswap_stub_end - x4_topswap_stub;
+	uint32_t eax = on;
+	uint32_t edx = (uintptr_t)pcr_reg_address(PID_RTC, PCR_RTC_BUC);
+
+	if (len > sizeof(topswap_buf))
+		return;
+	drain_uart();
+	memcpy(topswap_buf, x4_topswap_stub, len);
+	asm volatile("call *%2" : "+a"(eax), "+d"(edx) : "r"(topswap_buf) : "ecx", "memory", "cc");
+}
+
+static int ops_tss(void)
+{
+	return !!(pci_s_read_config32(PCI_DEV(0, 0x1f, 5), SPI_BC) & BC_TSS);
+}
+
+static int ops_buc_ts(void)
+{
+	return !!(pcr_read32(PID_RTC, PCR_RTC_BUC) & BUC_TS);
+}
+
+static uint32_t ops_mmio_fit_ptr(void)
+{
+	return read32((const void *)0xffffffc0);
+}
+
+/* Recovery role: return to the normal boot when nobody uses this mode */
+static void ops_idle(uint8_t reason)
+{
+	if (reason == UF_R_WRITTEN) {
+		printk(BIOS_NOTICE, "X4 recovery: idle, but flash was written: staying\n");
+		return;
+	}
+	if (reason == UF_R_NO_BOOT || reason == UF_R_NO_FMAP) {
+		printk(BIOS_NOTICE, "X4 recovery: idle, but the %s is damaged: staying\n",
+		       reason == UF_R_NO_BOOT ? "bootblock" : "FMAP");
+		return;
+	}
+	if (reason) {
+		printk(BIOS_NOTICE, "X4 recovery: idle, but flash reads follow Top Swap: staying\n");
+		return;
+	}
+	printk(BIOS_NOTICE, "X4 recovery: idle for %d minutes, clearing Top Swap\n",
+	       IDLE_MS / 60000);
+	ops_topswap(0);
+	printk(BIOS_NOTICE, "X4 recovery: the Top Swap strap is set, staying in recovery\n");
+}
+
+static const struct uf_ops ops = {
+	.rx = ops_rx,
+	.tx = ops_tx,
+	.now_us = ops_now_us,
+	.read = ops_read,
+	.erase = ops_erase,
+	.write = ops_write,
+	.reset = ops_reset,
+	.topswap = ops_topswap,
+	.tss = ops_tss,
+	.buc_ts = ops_buc_ts,
+	.idle = ops_idle,
+	.mmio_fit_ptr = ops_mmio_fit_ptr,
+	.idle_ms = CONFIG(RADXA_X4_RECOVERY) ? IDLE_MS : 0,
+	.role = CONFIG(RADXA_X4_RECOVERY) ? UF_ROLE_RECOVERY : UF_ROLE_NORMAL,
+	.build_id = coreboot_version,
+	.written = &written,
+};
+
+void x4_uart_flash_check(void)
+{
+	uart_base = uart_platform_baseptr(CONFIG_UART_FOR_CONSOLE);
+	flash = boot_device_rw();
+	if (!uart_base || !flash) {
+		printk(BIOS_ERR, "X4 UART flash: unavailable\n");
+		return;
+	}
+
+	printk(BIOS_NOTICE, "X4: send '%s' within %d s for UART flash mode\n", UF_MAGIC,
+	       WINDOW_MS / 1000);
+	if (!uf_wait_magic(&ops, WINDOW_MS))
+		return;
+
+	/* uf_serve() then refuses writes: the FMAP in flash isn't the one this bootblock knows */
+	if (!uf_fmap_ok(&ops))
+		printk(BIOS_ERR, "X4 UART flash: FMAP doesn't match this bootblock: enter recovery\n");
+	printk(BIOS_NOTICE, "X4: UART flash mode\n");
+	uart_tx_flush(CONFIG_UART_FOR_CONSOLE);
+	uf_serve(&ops);
+	printk(BIOS_NOTICE, "X4: UART flash mode left, booting\n");
+}
+
+#if CONFIG(RADXA_X4_RECOVERY)
+/* A fatal error in recovery returns to the normal boot, if that is as safe as the idle return */
+void die_notify(void)
+{
+	if (!flash)
+		flash = boot_device_rw();
+	if (flash && uf_leave_reason(&ops, false) == UF_R_NONE) {
+		printk(BIOS_EMERG, "X4 recovery: clearing Top Swap\n");
+		ops_topswap(0);
+	}
+	printk(BIOS_EMERG, "X4 recovery: halting with Top Swap set\n");
+}
+#endif
+
+/* Recovery role: serve until Top Swap is cleared; never boots on */
+void x4_recovery_main(void)
+{
+	uart_base = uart_platform_baseptr(CONFIG_UART_FOR_CONSOLE);
+	flash = boot_device_rw();
+	if (!uart_base || !flash)
+		die("X4 recovery: no UART or no writable boot device\n");
+
+	for (;;) {
+		printk(BIOS_NOTICE, "X4 recovery %s: Top Swap status %d, BUC.TS %d. Send '%s' "
+		       "for UART flash mode\n", coreboot_version, ops_tss(), ops_buc_ts(),
+		       UF_MAGIC);
+		if (!uf_wait_magic(&ops, IDLE_MS)) {
+			ops_idle(uf_leave_reason(&ops, false));
+			continue;
+		}
+		printk(BIOS_NOTICE, "X4 recovery: UART flash mode\n");
+		uart_tx_flush(CONFIG_UART_FOR_CONSOLE);
+		uf_serve(&ops);
+	}
+}
