index 00000000..8c7cfb7c
--- /dev/null
+++ b/src/mainboard/radxa/x4/uart_flash_proto.c
@@ -0,0 +1,606 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <string.h>
+#include "uart_flash_proto.h"
+
+#define UF_SOF0		0xa5
+#define UF_SOF1		0x5a
+#define UF_MAX_PAYLOAD	(4 + UF_BLOCK)
+#define UF_BYTE_TIMEOUT_US	500000
+
+#define TS_MMIO		0xfffc0000	/* where the Top Swap block runs */
+#define FLASH_MMIO	(0u - UF_FLASH_SIZE)	/* where the flash is mapped without Top Swap */
+#define FIT_PTR		0x40		/* the FIT pointer is at 4 GiB - 0x40 */
+#define IDLE_NEVER	UINT64_MAX
+
+#define W	UF_K_WRITABLE
+#define U	UF_K_UNLOCK
+#define P	UF_K_PROTECTED
+
+/* Never written: the descriptor, the ME, and the block this role runs from */
+static const struct uf_range normal_ranges[] = {
+	{ 0, UF_ME_START, P, 0, UF_F_FMAP | UF_F_KEEP, "SI_DESC" },
+	{ UF_ME_START, UF_REGION9_START, P, 0, UF_F_FMAP | UF_F_KEEP, "SI_ME" },
+	{ UF_REGION9_START, UF_BIOS_START, P, 0, UF_F_KEEP, "region 9" },
+	{ UF_BIOS_START, UF_SMMSTORE_START, W, 0, UF_F_FMAP | UF_F_DATA, "RW_MRC_CACHE" },
+	{ UF_SMMSTORE_START, UF_FMAP_START, W, 0, UF_F_FMAP | UF_F_DATA, "SMMSTORE" },
+	{ UF_FMAP_START, UF_CBFS_START, P, 0, UF_F_FMAP, "FMAP" },
+	{ UF_CBFS_START, UF_TS_START, W, 0, UF_F_FMAP, "COREBOOT" },
+	{ UF_TS_START, UF_TOP_START, U, UF_UNLOCK_RECOVERY, UF_F_RESET | UF_F_TS, "recovery block" },
+	{ UF_TOP_START, UF_FLASH_SIZE, P, 0, UF_F_RESET, "bootblock" },
+};
+static const struct uf_range recovery_ranges[] = {
+	{ 0, UF_ME_START, P, 0, UF_F_FMAP | UF_F_KEEP, "SI_DESC" },
+	{ UF_ME_START, UF_REGION9_START, P, 0, UF_F_FMAP | UF_F_KEEP, "SI_ME" },
+	{ UF_REGION9_START, UF_BIOS_START, W, 0, UF_F_FULL, "region 9" },
+	{ UF_BIOS_START, UF_SMMSTORE_START, W, 0, UF_F_FMAP | UF_F_DATA, "RW_MRC_CACHE" },
+	{ UF_SMMSTORE_START, UF_FMAP_START, W, 0, UF_F_FMAP | UF_F_DATA, "SMMSTORE" },
+	{ UF_FMAP_START, UF_CBFS_START, U, UF_UNLOCK_FMAP, UF_F_FMAP, "FMAP" },
+	{ UF_CBFS_START, UF_TS_START, W, 0, UF_F_FMAP, "COREBOOT" },
+	{ UF_TS_START, UF_TOP_START, P, 0, UF_F_KEEP | UF_F_RESET | UF_F_TS, "recovery block" },
+	{ UF_TOP_START, UF_FLASH_SIZE, U, UF_UNLOCK_TOP, UF_F_RESET, "bootblock" },
+};
+
+#define N(a) (sizeof(a) / sizeof((a)[0]))
+
+const struct uf_range *uf_ranges(enum uf_role role, size_t *n)
+{
+	if (role == UF_ROLE_RECOVERY) {
+		*n = N(recovery_ranges);
+		return recovery_ranges;
+	}
+	*n = N(normal_ranges);
+	return normal_ranges;
+}
+
+static uint32_t crc_table[256];
+static uint8_t rx_buf[UF_MAX_PAYLOAD];
+static uint8_t blk_buf[UF_BLOCK];
+static uint32_t crc_buf[UF_MAX_CRCS];
+
+uint32_t uf_crc32(uint32_t crc, const void *buf, size_t len)
+{
+	const uint8_t *p = buf;
+
+	if (!crc_table[1]) {
+		for (uint32_t i = 0; i < 256; i++) {
+			uint32_t c = i;
+			for (int k = 0; k < 8; k++)
+				c = (c & 1) ? 0xedb88320 ^ (c >> 1) : c >> 1;
+			crc_table[i] = c;
+		}
+	}
+	crc = ~crc;
+	while (len--)
+		crc = crc_table[(crc ^ *p++) & 0xff] ^ (crc >> 8);
+	return ~crc;
+}
+
+static bool inside(const struct uf_range *r, uint32_t off, uint32_t len)
+{
+	return off >= r->start && off + len <= r->end;
+}
+
+bool uf_writable(const struct uf_ops *ops, uint32_t off, uint32_t len, uint8_t unlocked)
+{
+	size_t n;
+	const struct uf_range *r = uf_ranges(ops->role, &n);
+
+	if (len == 0 || off >= UF_FLASH_SIZE || len > UF_FLASH_SIZE - off)
+		return false;
+	for (size_t i = 0; i < n; i++) {
+		if (!inside(&r[i], off, len))
+			continue;
+		if (r[i].kind == UF_K_WRITABLE)
+			return true;
+		if (r[i].kind == UF_K_UNLOCK && (unlocked & r[i].bit))
+			return true;
+	}
+	return false;
+}
+
+bool uf_wait_magic(const struct uf_ops *ops, uint32_t window_ms)
+{
+	const char *magic = UF_MAGIC;
+	const size_t mlen = strlen(magic);
+	const uint64_t end = window_ms ? ops->now_us() + (uint64_t)window_ms * 1000 : IDLE_NEVER;
+	size_t idx = 0;
+
+	while (ops->now_us() < end) {
+		int b = ops->rx();
+		if (b < 0)
+			continue;
+		if (b == magic[idx])
+			idx++;
+		else
+			idx = (b == magic[0]) ? 1 : 0;
+		if (idx == mlen)
+			return true;
+	}
+	return false;
+}
+
+static void put_le16(uint8_t *p, uint16_t v)
+{
+	p[0] = v;
+	p[1] = v >> 8;
+}
+
+static void put_le32(uint8_t *p, uint32_t v)
+{
+	for (int i = 0; i < 4; i++)
+		p[i] = v >> (8 * i);
+}
+
+static uint32_t get_le32(const uint8_t *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void tx_buf(const struct uf_ops *ops, const void *buf, size_t len, uint32_t *crc)
+{
+	const uint8_t *p = buf;
+
+	if (crc)
+		*crc = uf_crc32(*crc, buf, len);
+	while (len--)
+		ops->tx(*p++);
+}
+
+/* A reply is a short head plus an optional data part, sent without copying */
+static void tx_frame(const struct uf_ops *ops, uint8_t type, uint8_t seq,
+		     const void *head, size_t head_len, const void *data, size_t data_len)
+{
+	uint8_t hdr[6] = { UF_SOF0, UF_SOF1, type, seq };
+	uint8_t tail[4];
+	uint32_t crc = 0;
+
+	put_le16(hdr + 4, head_len + data_len);
+	ops->tx(hdr[0]);
+	ops->tx(hdr[1]);
+	tx_buf(ops, hdr + 2, 4, &crc);
+	if (head_len)
+		tx_buf(ops, head, head_len, &crc);
+	if (data_len)
+		tx_buf(ops, data, data_len, &crc);
+	put_le32(tail, crc);
+	tx_buf(ops, tail, 4, NULL);
+}
+
+static int rx_byte_timeout(const struct uf_ops *ops)
+{
+	const uint64_t end = ops->now_us() + UF_BYTE_TIMEOUT_US;
+	int b;
+
+	while ((b = ops->rx()) < 0) {
+		if (ops->now_us() >= end)
+			return -1;
+	}
+	return b;
+}
+
+enum rx_result { RX_OK, RX_BAD_CRC, RX_BAD_LEN, RX_TIMEOUT, RX_IDLE };
+
+/*
+ * Waits for a frame until idle_end. Bytes outside a frame (console text, magic repeats)
+ * are skipped.
+ */
+static enum rx_result rx_frame(const struct uf_ops *ops, uint64_t idle_end, uint8_t *type,
+			       uint8_t *seq, uint16_t *len)
+{
+	uint8_t hdr[4], tail[4];
+	int b, prev = -1;
+	uint32_t crc;
+
+	for (;;) {
+		/* Only valid frames restart the idle timer, not noise from a floating RX line */
+		if (ops->now_us() >= idle_end)
+			return RX_IDLE;
+		b = ops->rx();
+		if (b < 0)
+			continue;
+		if (prev == UF_SOF0 && b == UF_SOF1)
+			break;
+		prev = b;
+	}
+	for (int i = 0; i < 4; i++) {
+		if ((b = rx_byte_timeout(ops)) < 0)
+			return RX_TIMEOUT;
+		hdr[i] = b;
+	}
+	*type = hdr[0];
+	*seq = hdr[1];
+	*len = hdr[2] | hdr[3] << 8;
+	if (*len > UF_MAX_PAYLOAD)
+		return RX_BAD_LEN;
+	for (size_t i = 0; i < *len; i++) {
+		if ((b = rx_byte_timeout(ops)) < 0)
+			return RX_TIMEOUT;
+		rx_buf[i] = b;
+	}
+	for (int i = 0; i < 4; i++) {
+		if ((b = rx_byte_timeout(ops)) < 0)
+			return RX_TIMEOUT;
+		tail[i] = b;
+	}
+	crc = uf_crc32(0, hdr, 4);
+	crc = uf_crc32(crc, rx_buf, *len);
+	return crc == get_le32(tail) ? RX_OK : RX_BAD_CRC;
+}
+
+static void tx_nak(const struct uf_ops *ops, uint8_t seq, uint8_t reason)
+{
+	tx_frame(ops, UF_NAK, seq, &reason, 1, NULL, 0);
+}
+
+/*
+ * In the recovery role the CPU sees the Top Swap block at the top of the 4 GiB window. Flash
+ * reads by offset must not: else the two top blocks can't be told apart.
+ */
+static bool reads_swapped(const struct uf_ops *ops)
+{
+	uint8_t v[4];
+
+	if (ops->role != UF_ROLE_RECOVERY)
+		return false;
+	return ops->read(UF_TOP_START - FIT_PTR, v, 4) || get_le32(v) != ops->mmio_fit_ptr();
+}
+
+/* HELLO: ver, block16, size32, role, tss, buc_ts, unlocked, status, idlen, id, nranges,
+ * then per range start32, end32, kind, bit, flags, namelen, name */
+static void do_hello(const struct uf_ops *ops, uint8_t seq, uint8_t unlocked, bool fmap_bad)
+{
+	size_t nr, idlen = ops->build_id ? strnlen(ops->build_id, UF_MAX_NAME) : 0;
+	const struct uf_range *r = uf_ranges(ops->role, &nr);
+	uint8_t *p = blk_buf;
+	size_t n = 0;
+
+	p[n++] = UF_VERSION;
+	put_le16(p + n, UF_BLOCK);
+	n += 2;
+	put_le32(p + n, UF_FLASH_SIZE);
+	n += 4;
+	p[n++] = ops->role;
+	p[n++] = ops->tss();
+	p[n++] = ops->buc_ts();
+	p[n++] = unlocked;
+	p[n++] = (reads_swapped(ops) ? UF_S_SWAPPED : 0) | (fmap_bad ? UF_S_LAYOUT : 0);
+	p[n++] = idlen;
+	memcpy(p + n, ops->build_id, idlen);
+	n += idlen;
+	p[n++] = nr;
+	for (size_t i = 0; i < nr; i++) {
+		size_t len = strnlen(r[i].name, UF_MAX_NAME);
+
+		put_le32(p + n, r[i].start);
+		put_le32(p + n + 4, r[i].end);
+		n += 8;
+		p[n++] = r[i].kind;
+		p[n++] = r[i].bit;
+		p[n++] = r[i].flags;
+		p[n++] = len;
+		memcpy(p + n, r[i].name, len);
+		n += len;
+	}
+	tx_frame(ops, UF_HELLO | UF_REPLY, seq, p, n, NULL, 0);
+}
+
+static void do_crcs(const struct uf_ops *ops, uint8_t seq, uint16_t len)
+{
+	uint8_t p[7];
+	uint32_t start;
+	uint16_t count;
+
+	if (len != 6) {
+		tx_nak(ops, seq, UF_R_BAD_LEN);
+		return;
+	}
+	start = get_le32(rx_buf);
+	count = rx_buf[4] | rx_buf[5] << 8;
+	memcpy(p, rx_buf, 6);
+	p[6] = UF_OK;
+	if (start % UF_BLOCK || count == 0 || count > UF_MAX_CRCS ||
+	    start >= UF_FLASH_SIZE || (UF_FLASH_SIZE - start) / UF_BLOCK < count) {
+		p[6] = UF_ERR;
+		tx_frame(ops, UF_CRCS | UF_REPLY, seq, p, 7, NULL, 0);
+		return;
+	}
+	for (uint16_t i = 0; i < count; i++) {
+		if (ops->read(start + i * UF_BLOCK, blk_buf, UF_BLOCK)) {
+			p[6] = UF_ERR;
+			tx_frame(ops, UF_CRCS | UF_REPLY, seq, p, 7, NULL, 0);
+			return;
+		}
+		crc_buf[i] = uf_crc32(0, blk_buf, UF_BLOCK);
+	}
+	/* x86 is little endian, so crc_buf goes out as is */
+	tx_frame(ops, UF_CRCS | UF_REPLY, seq, p, 7, crc_buf, count * 4);
+}
+
+static bool all_ff(const uint8_t *p, size_t len)
+{
+	while (len--)
+		if (*p++ != 0xff)
+			return false;
+	return true;
+}
+
+/* Returns status and sets *reason; *dirty is set once flash was erased */
+static uint8_t write_block(const struct uf_ops *ops, uint32_t addr, const uint8_t *data,
+			   uint8_t unlocked, uint8_t *reason, bool *dirty)
+{
+	*reason = UF_R_NONE;
+	if (addr % UF_BLOCK) {
+		*reason = UF_R_NOT_ALIGNED;
+		return UF_ERR;
+	}
+	if (!uf_writable(ops, addr, UF_BLOCK, unlocked)) {
+		*reason = UF_R_NOT_WRITABLE;
+		return UF_ERR;
+	}
+	if (ops->read(addr, blk_buf, UF_BLOCK)) {
+		*reason = UF_R_IO_READ;
+		return UF_ERR;
+	}
+	if (!memcmp(blk_buf, data, UF_BLOCK))
+		return UF_SKIP;
+
+	for (int attempt = 0; attempt < 2; attempt++) {
+		*dirty = true;
+		*ops->written = true;
+		if (ops->erase(addr, UF_BLOCK)) {
+			*reason = UF_R_IO_ERASE;
+			continue;
+		}
+		if (!all_ff(data, UF_BLOCK) && ops->write(addr, data, UF_BLOCK)) {
+			*reason = UF_R_IO_WRITE;
+			continue;
+		}
+		if (ops->read(addr, blk_buf, UF_BLOCK)) {
+			*reason = UF_R_IO_READ;
+			continue;
+		}
+		if (memcmp(blk_buf, data, UF_BLOCK)) {
+			*reason = UF_R_VERIFY;
+			continue;
+		}
+		*reason = UF_R_NONE;
+		return UF_OK;
+	}
+	return UF_ERR;
+}
+
+static void do_write(const struct uf_ops *ops, uint8_t seq, uint16_t len, uint8_t unlocked,
+		     bool fmap_bad, bool *dirty)
+{
+	uint8_t p[6];
+	uint8_t reason = UF_R_LAYOUT;
+
+	if (len != 4 + UF_BLOCK) {
+		tx_nak(ops, seq, UF_R_BAD_LEN);
+		return;
+	}
+	memcpy(p, rx_buf, 4);
+	p[4] = fmap_bad ? UF_ERR :
+	       write_block(ops, get_le32(rx_buf), rx_buf + 4, unlocked, &reason, dirty);
+	p[5] = reason;
+	tx_frame(ops, UF_WRITE | UF_REPLY, seq, p, 6, NULL, 0);
+}
+
+static void do_read(const struct uf_ops *ops, uint8_t seq, uint16_t len)
+{
+	uint8_t p[5];
+	uint32_t addr;
+
+	if (len != 4) {
+		tx_nak(ops, seq, UF_R_BAD_LEN);
+		return;
+	}
+	addr = get_le32(rx_buf);
+	memcpy(p, rx_buf, 4);
+	if (addr % UF_BLOCK || addr >= UF_FLASH_SIZE) {
+		p[4] = UF_ERR;
+		tx_frame(ops, UF_READ | UF_REPLY, seq, p, 5, NULL, 0);
+		return;
+	}
+	if (ops->read(addr, blk_buf, UF_BLOCK)) {
+		p[4] = UF_ERR;
+		tx_frame(ops, UF_READ | UF_REPLY, seq, p, 5, NULL, 0);
+		return;
+	}
+	p[4] = UF_OK;
+	tx_frame(ops, UF_READ | UF_REPLY, seq, p, 5, blk_buf, UF_BLOCK);
+}
+
+static void do_unlock(const struct uf_ops *ops, uint8_t seq, uint16_t len, uint8_t *unlocked,
+		      bool fmap_bad)
+{
+	const size_t mlen = strlen(UF_UNLOCK_MAGIC);
+	size_t nr;
+	const struct uf_range *r = uf_ranges(ops->role, &nr);
+	uint8_t allowed = 0, p[3] = { UF_OK, UF_R_NONE, 0 };
+
+	if (len != mlen + 1) {
+		tx_nak(ops, seq, UF_R_BAD_LEN);
+		return;
+	}
+	for (size_t i = 0; i < nr; i++)
+		if (r[i].kind == UF_K_UNLOCK)
+			allowed |= r[i].bit;
+	if (memcmp(rx_buf, UF_UNLOCK_MAGIC, mlen) || (rx_buf[mlen] & ~allowed)) {
+		p[0] = UF_ERR;
+		p[1] = UF_R_BAD_UNLOCK;
+	} else if (fmap_bad) {
+		p[0] = UF_ERR;
+		p[1] = UF_R_LAYOUT;
+	} else if ((rx_buf[mlen] & UF_UNLOCK_TOP) && reads_swapped(ops)) {
+		p[0] = UF_ERR;
+		p[1] = UF_R_SWAPPED;
+	} else {
+		*unlocked |= rx_buf[mlen];
+	}
+	p[2] = *unlocked;
+	tx_frame(ops, UF_UNLOCK | UF_REPLY, seq, p, 3, NULL, 0);
+}
+
+/*
+ * The block ending at `end` can start the CPU: a reset vector, and a FIT pointer to a FIT.
+ * A FIT pointer value p from `mmio` up is at flash offset p - mmio + base.
+ */
+static bool bootable(const struct uf_ops *ops, uint32_t end, uint32_t mmio, uint32_t base)
+{
+	uint32_t fit, off;
+
+	if (ops->read(end - UF_BLOCK, blk_buf, UF_BLOCK) || all_ff(blk_buf + UF_BLOCK - 16, 16))
+		return false;
+	fit = get_le32(blk_buf + UF_BLOCK - FIT_PTR);
+	if (fit < mmio || fit > UINT32_MAX - 16)
+		return false;
+	off = fit - mmio + base;
+	if (off % UF_BLOCK > UF_BLOCK - 8 || ops->read(off - off % UF_BLOCK, blk_buf, UF_BLOCK))
+		return false;
+	return !memcmp(blk_buf + off % UF_BLOCK, "_FIT_   ", 8);
+}
+
+bool uf_fmap_ok(const struct uf_ops *ops)
+{
+	static const struct { const char *name; uint32_t start, end; } want[] = {
+		{ "RW_MRC_CACHE", UF_BIOS_START, UF_SMMSTORE_START },
+		{ "SMMSTORE", UF_SMMSTORE_START, UF_FMAP_START },
+		{ "FMAP", UF_FMAP_START, UF_CBFS_START },
+		{ "COREBOOT", UF_CBFS_START, UF_FLASH_SIZE },
+	};
+	const uint8_t *h = blk_buf;
+	size_t n;
+
+	/* struct fmap: signature, ver_major, ver_minor, base64, size32, name[32], nareas16 */
+	if (ops->read(UF_FMAP_START, blk_buf, UF_BLOCK) || memcmp(h, "__FMAP__", 8) ||
+	    h[8] != 1 || get_le32(h + 18) != UF_FLASH_SIZE)
+		return false;
+	n = h[0x36] | h[0x37] << 8;
+	if (0x38 + n * 42 > UF_BLOCK)
+		return false;
+	for (size_t w = 0; w < N(want); w++) {
+		const uint8_t *a = NULL;
+
+		/* struct fmap_area: offset32, size32, name[32], flags16 */
+		for (size_t i = 0; i < n && !a; i++)
+			if (!strncmp((const char *)h + 0x38 + i * 42 + 8, want[w].name, 32))
+				a = h + 0x38 + i * 42;
+		if (!a || get_le32(a) != want[w].start ||
+		    get_le32(a + 4) != want[w].end - want[w].start)
+			return false;
+	}
+	return true;
+}
+
+uint8_t uf_leave_reason(const struct uf_ops *ops, bool asked)
+{
+	if (!asked && *ops->written)
+		return UF_R_WRITTEN;
+	if (reads_swapped(ops))
+		return UF_R_SWAPPED;
+	if (!bootable(ops, UF_FLASH_SIZE, FLASH_MMIO, 0))
+		return UF_R_NO_BOOT;
+	if (!uf_fmap_ok(ops))
+		return UF_R_NO_FMAP;
+	return UF_R_NONE;
+}
+
+static void do_topswap(const struct uf_ops *ops, uint8_t seq, uint16_t len)
+{
+	uint8_t p[2] = { UF_OK, UF_R_NONE };
+	int on;
+
+	if (len != 1) {
+		tx_nak(ops, seq, UF_R_BAD_LEN);
+		return;
+	}
+	on = rx_buf[0];
+	if (on != (ops->role == UF_ROLE_NORMAL)) {
+		p[0] = UF_ERR;
+		p[1] = UF_R_BAD_ROLE;
+	} else if (on && !bootable(ops, UF_TOP_START, TS_MMIO, UF_TS_START)) {
+		p[0] = UF_ERR;
+		p[1] = UF_R_NO_RECOVERY;
+	} else if (!on) {
+		p[1] = uf_leave_reason(ops, true);
+		p[0] = p[1] ? UF_ERR : UF_OK;
+	}
+	tx_frame(ops, UF_TOPSWAP | UF_REPLY, seq, p, 2, NULL, 0);
+	if (p[0] != UF_OK)
+		return;
+	ops->topswap(on);
+	/* Still here: the bit did not change, so this block still runs */
+	p[0] = UF_ERR;
+	p[1] = on ? UF_R_TS_LOCKED : UF_R_STRAP;
+	tx_frame(ops, UF_TOPSWAP | UF_REPLY, seq, p, 2, NULL, 0);
+}
+
+void uf_serve(const struct uf_ops *ops)
+{
+	bool dirty = false;
+	uint8_t type, seq, unlocked = 0;
+	uint16_t len;
+	uint64_t idle_end = IDLE_NEVER;
+	/* A normal bootblock whose FMAP moved can still read and enter recovery, but not write */
+	const bool fmap_bad = ops->role == UF_ROLE_NORMAL && !uf_fmap_ok(ops);
+
+	do_hello(ops, 0, unlocked, fmap_bad);
+	for (;;) {
+		if (idle_end == IDLE_NEVER && ops->idle_ms)
+			idle_end = ops->now_us() + (uint64_t)ops->idle_ms * 1000;
+		switch (rx_frame(ops, idle_end, &type, &seq, &len)) {
+		case RX_OK:
+			idle_end = IDLE_NEVER;
+			break;
+		case RX_BAD_CRC:
+			tx_nak(ops, seq, UF_R_BAD_CRC);
+			continue;
+		case RX_BAD_LEN:
+			tx_nak(ops, seq, UF_R_BAD_LEN);
+			continue;
+		case RX_TIMEOUT:
+			continue;
+		case RX_IDLE:
+			ops->idle(uf_leave_reason(ops, false));
+			idle_end = IDLE_NEVER;
+			continue;
+		}
+		switch (type) {
+		case UF_HELLO:
+			do_hello(ops, seq, unlocked, fmap_bad);
+			break;
+		case UF_CRCS:
+			do_crcs(ops, seq, len);
+			break;
+		case UF_WRITE:
+			do_write(ops, seq, len, unlocked, fmap_bad, &dirty);
+			break;
+		case UF_READ:
+			do_read(ops, seq, len);
+			break;
+		case UF_UNLOCK:
+			do_unlock(ops, seq, len, &unlocked, fmap_bad);
+			break;
+		case UF_TOPSWAP:
+			do_topswap(ops, seq, len);
+			break;
+		case UF_RESET:
+			tx_frame(ops, UF_RESET | UF_REPLY, seq, NULL, 0, NULL, 0);
+			ops->reset();
+			break;
+		case UF_EXIT: {
+			/* Once flash changed, the CBFS this boot already looked at is stale */
+			uint8_t st = dirty ? UF_ERR : UF_OK;
+			tx_frame(ops, UF_EXIT | UF_REPLY, seq, &st, 1, NULL, 0);
+			if (dirty)
+				ops->reset();
+			return;
+		}
+		default:
+			tx_nak(ops, seq, UF_R_BAD_TYPE);
+			break;
+		}
+	}
+}
diff --git a/src/mainboard/radxa/x4/uart_flash_proto.h b/src/mainboard/radxa/x4/uart_flash_proto.h
new file mode 100644
index 00000000..b43659b0
--- /dev/null
+++ b/src/mainboard/radxa/x4/uart_flash_proto.h
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* X4 UART flash mode: protocol core, also built by the host test harness. */
+
+#ifndef X4_UART_FLASH_PROTO_H
+#define X4_UART_FLASH_PROTO_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define UF_VERSION	2
+#define UF_BLOCK	4096
+#define UF_MAGIC	"x4flash"
+#define UF_MAX_CRCS	1024
+#define UF_UNLOCK_MAGIC	"UNLOCK-PROTECTED"
+#define UF_MAX_NAME	32	/* build id and range names in HELLO */
+
+/* Flash layout (board.fmd); uart_flash.c checks it against the FMAP at build time */
+#define UF_ME_START		0x001000	/* after the descriptor */
+#define UF_REGION9_START	0x45c000	/* descriptor region 9, after the ME */
+#define UF_BIOS_START		0x600000	/* RW_MRC_CACHE */
+#define UF_SMMSTORE_START	0x620000
+#define UF_FMAP_START		0x720000
+#define UF_CBFS_START		0x721000
+#define UF_TS_START		0xf80000	/* Top Swap block: the recovery bootblock */
+#define UF_TOP_START		0xfc0000	/* the normal bootblock's block */
+#define UF_FLASH_SIZE		0x1000000
+
+enum uf_role {
+	UF_ROLE_NORMAL = 0,	/* the normal bootblock */
+	UF_ROLE_RECOVERY = 1,	/* the recovery bootblock, run with Top Swap set */
+};
+
+/* UF_UNLOCK mask bits */
+#define UF_UNLOCK_FMAP		(1 << 0)	/* recovery role: the FMAP block */
+#define UF_UNLOCK_TOP		(1 << 1)	/* recovery role: the normal bootblock's block */
+#define UF_UNLOCK_RECOVERY	(1 << 2)	/* normal role: the Top Swap block */
+
+/* Frame: a5 5a type seq len16 payload crc32(type..payload), little endian */
+enum uf_type {
+	UF_HELLO = 0x01,
+	UF_CRCS = 0x02,
+	UF_WRITE = 0x03,
+	UF_READ = 0x04,
+	UF_RESET = 0x05,
+	UF_EXIT = 0x06,
+	UF_UNLOCK = 0x07,
+	UF_TOPSWAP = 0x08,
+	UF_REPLY = 0x80,	/* reply type = request type | UF_REPLY */
+	UF_NAK = 0x7f,
+};
+
+enum uf_status {
+	UF_OK = 0,
+	UF_SKIP = 1,
+	UF_ERR = 2,
+};
+
+enum uf_reason {
+	UF_R_NONE = 0,
+	UF_R_BAD_CRC = 1,
+	UF_R_BAD_LEN = 2,
+	UF_R_BAD_TYPE = 3,
+	UF_R_NOT_ALIGNED = 4,
+	UF_R_NOT_WRITABLE = 5,
+	UF_R_RANGE = 6,
+	UF_R_IO_READ = 7,
+	UF_R_IO_ERASE = 8,
+	UF_R_IO_WRITE = 9,
+	UF_R_VERIFY = 10,
+	UF_R_BAD_UNLOCK = 11,	/* wrong magic, or bits this role can't unlock */
+	UF_R_BAD_ROLE = 12,	/* Top Swap request not valid in this role */
+	UF_R_NO_RECOVERY = 13,	/* the Top Swap block holds no recovery bootblock */
+	UF_R_TS_LOCKED = 14,	/* BUC.TS did not change */
+	UF_R_STRAP = 15,	/* the Top Swap strap holds Top Swap on */
+	UF_R_WRITTEN = 16,	/* this boot wrote flash: only an explicit request leaves */
+	UF_R_NO_BOOT = 17,	/* the normal top block has no reset vector or FIT */
+	UF_R_SWAPPED = 18,	/* flash reads follow Top Swap, so the top block can't be told apart */
+	UF_R_NO_FMAP = 19,	/* the FMAP is not the one the normal bootblock expects */
+	UF_R_LAYOUT = 20,	/* normal role: the FMAP doesn't match this bootblock */
+};
+
+/* HELLO status bits */
+#define UF_S_SWAPPED	(1 << 0)	/* see UF_R_SWAPPED */
+#define UF_S_LAYOUT	(1 << 1)	/* see UF_R_LAYOUT: only reads, TOPSWAP 1 and RESET */
+
+struct uf_ops {
+	int (*rx)(void);	/* next byte, or -1 if none is waiting */
+	void (*tx)(uint8_t b);
+	uint64_t (*now_us)(void);
+	int (*read)(uint32_t off, void *buf, size_t len);	/* 0 on success */
+	int (*erase)(uint32_t off, size_t len);
+	int (*write)(uint32_t off, const void *buf, size_t len);
+	void (*reset)(void);	/* must not return */
+	/* Sets BUC.TS and resets. Returns only if the bit did not change. */
+	void (*topswap)(int on);
+	int (*tss)(void);	/* Top Swap status as the PCH reports it */
+	int (*buc_ts)(void);	/* BUC.TS */
+	/* After idle_ms without a valid frame; reason is uf_leave_reason(ops, false) */
+	void (*idle)(uint8_t reason);
+	uint32_t (*mmio_fit_ptr)(void);	/* the dword the CPU reads at 0xffffffc0 */
+	uint32_t idle_ms;	/* 0: no idle timer */
+	enum uf_role role;
+	const char *build_id;
+	bool *written;		/* set once this boot erased any block */
+};
+
+/* What a role does with a range; HELLO reports every range, so the host needs no layout */
+enum uf_kind {
+	UF_K_WRITABLE = 0,
+	UF_K_UNLOCK = 1,	/* writable after UF_UNLOCK with the range's bit */
+	UF_K_PROTECTED = 2,	/* never written in this role */
+};
+
+/* Range flags, for the host */
+#define UF_F_FMAP	(1 << 0)	/* starts the FMAP area of this name, and ends inside it */
+#define UF_F_DATA	(1 << 1)	/* runtime data: kept unless the host is asked to write it */
+#define UF_F_FULL	(1 << 2)	/* written only from a full flash image */
+#define UF_F_KEEP	(1 << 3)	/* may differ from any image: the board keeps its copy */
+#define UF_F_RESET	(1 << 4)	/* its last block holds a reset vector */
+#define UF_F_TS		(1 << 5)	/* the Top Swap block, which TOPSWAP 1 starts */
+
+struct uf_range {
+	uint32_t start;
+	uint32_t end;	/* exclusive */
+	uint8_t kind;
+	uint8_t bit;	/* UF_K_UNLOCK: the UF_UNLOCK mask bit */
+	uint8_t flags;
+	const char *name;
+};
+
+uint32_t uf_crc32(uint32_t crc, const void *buf, size_t len);
+/* The ranges of a role, in flash order, covering the whole flash */
+const struct uf_range *uf_ranges(enum uf_role role, size_t *n);
+bool uf_writable(const struct uf_ops *ops, uint32_t off, uint32_t len, uint8_t unlocked);
+/* Waits for UF_MAGIC; window_ms 0 waits forever */
+bool uf_wait_magic(const struct uf_ops *ops, uint32_t window_ms);
+/* The FMAP at UF_FMAP_START is valid and has the areas where this layout puts them */
+bool uf_fmap_ok(const struct uf_ops *ops);
+/*
+ * Recovery role: UF_R_NONE if Top Swap may be cleared. The normal top block must be able
+ * to start the CPU, the FMAP must pass uf_fmap_ok() and, unless the host asked (TOPSWAP 0),
+ * nothing was written this boot.
+ */
+uint8_t uf_leave_reason(const struct uf_ops *ops, bool asked);
+/* Serves requests. Returns on EXIT when nothing was written; otherwise resets. */
+void uf_serve(const struct uf_ops *ops);
+
+#endif
