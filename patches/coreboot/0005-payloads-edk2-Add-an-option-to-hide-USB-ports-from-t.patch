From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Sat, 24 Oct 2026 10:34:41 -0500
Subject: [PATCH 05/15] payloads/edk2: Add an option to hide USB ports from the
 boot options

Some boards have onboard USB devices that enumerate as mass storage
but are not boot media, such as a microcontroller's ROM bootloader.

Add EDK2_HIDDEN_USB_BOOT_PORTS, a bitmask of root-hub ports of the
xHCI at 00:14.0 whose devices get no edk2 boot options. It sets
PcdBootHiddenUsbPorts, so the edk2 tree must have that PCD. The
default, 0, passes nothing.

[Generated by Claude, an AI model by Anthropic.]

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 payloads/external/Makefile.mk   |  1 +
 payloads/external/edk2/Kconfig  | 14 ++++++++++++++
 payloads/external/edk2/Makefile |  4 ++++
 3 files changed, 19 insertions(+)

diff --git a/payloads/external/Makefile.mk b/payloads/external/Makefile.mk
index f7d2bcfe..937b0e76 100644
--- a/payloads/external/Makefile.mk
+++ b/payloads/external/Makefile.mk
@@ -222,6 +222,7 @@ EDK2_PAYLOAD_ARGS = \
 	CONFIG_EDK2_FULL_SCREEN_SETUP=$(CONFIG_EDK2_FULL_SCREEN_SETUP) \
 	CONFIG_EDK2_HAVE_EFI_SHELL=$(CONFIG_EDK2_HAVE_EFI_SHELL) \
 	CONFIG_EDK2_PRIORITIZE_INTERNAL=$(CONFIG_EDK2_PRIORITIZE_INTERNAL) \
+	CONFIG_EDK2_HIDDEN_USB_BOOT_PORTS=$(CONFIG_EDK2_HIDDEN_USB_BOOT_PORTS) \
 	CONFIG_EDK2_LOAD_OPTION_ROMS=$(CONFIG_EDK2_LOAD_OPTION_ROMS) \
 	CONFIG_EDK2_PS2_SUPPORT=$(CONFIG_EDK2_PS2_SUPPORT) \
 	CONFIG_EDK2_SERIAL_SUPPORT=$(CONFIG_EDK2_SERIAL_SUPPORT) \
diff --git a/payloads/external/edk2/Kconfig b/payloads/external/edk2/Kconfig
index 5c429f35..62e97318 100644
--- a/payloads/external/edk2/Kconfig
+++ b/payloads/external/edk2/Kconfig
@@ -237,6 +237,20 @@ config EDK2_PRIORITIZE_INTERNAL
 	help
 	  Prioritize internal boot devices over external devices
 
+config EDK2_HIDDEN_USB_BOOT_PORTS
+	hex "USB ports without boot options"
+	depends on !EDK2_REPO_OFFICIAL
+	default 0x0
+	help
+	  Bitmask of root-hub ports of the xHCI controller at PCI 00:14.0 whose
+	  devices edk2 does not offer as boot options. Bit n is the port in
+	  edk2's USB(n,...) device path node: the 0-based xHCI port number,
+	  which is USB2 port n+1 on Intel PCHs. For onboard devices that can
+	  show up as mass storage but are not boot media. The devices stay
+	  usable from the shell and the OS.
+
+	  Needs an edk2 tree with PcdBootHiddenUsbPorts.
+
 config EDK2_LOAD_OPTION_ROMS
 	bool "Load and Execute OpROMs on PCIe devices"
 	default n
diff --git a/payloads/external/edk2/Makefile b/payloads/external/edk2/Makefile
index 75b7f798..e091629a 100644
--- a/payloads/external/edk2/Makefile
+++ b/payloads/external/edk2/Makefile
@@ -202,6 +202,10 @@ endif
 ifeq ($(CONFIG_EDK2_PRIORITIZE_INTERNAL),y)
 BUILD_STR += -D PRIORITIZE_INTERNAL=TRUE
 endif
+# PcdBootHiddenUsbPorts	= 0
+ifneq ($(filter-out 0 0x0,$(CONFIG_EDK2_HIDDEN_USB_BOOT_PORTS)),)
+BUILD_STR += --pcd gUefiPayloadPkgTokenSpaceGuid.PcdBootHiddenUsbPorts=$(CONFIG_EDK2_HIDDEN_USB_BOOT_PORTS)
+endif
 # TPM_ENABLE			= TRUE
 ifeq ($(CONFIG_EDK2_DISABLE_TPM),y)
 BUILD_STR += -D TPM_ENABLE=FALSE
