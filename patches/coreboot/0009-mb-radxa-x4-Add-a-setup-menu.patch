@@ -5,6 +5,8 @@
 #include <soc/meminit.h>
 #include <soc/romstage.h>
 #include <gpio.h>
+#include <option.h>
+#include <types.h>
 
 static const struct mb_cfg lp5_mem_config = {
 	.type = MEM_TYPE_LP5X,
@@ -103,4 +105,11 @@ void mainboard_memory_init_params(FSPM_UPD *memupd)
 	memupd->FspmConfig.MemorySpdPtr010 = 0;
 	memupd->FspmConfig.DisableMc0Ch0 = 1;
 	memupd->FspmConfig.DisableMc0Ch1 = 1;
+
+	/* Wi-Fi off: also turn off its root port (RP4) and clock source 2 (0xff: not used) */
+	if (!get_uint_option("wifi_enable", 1)) {
+		memupd->FspmConfig.PcieRpEnableMask &= ~BIT(3);
+		memupd->FspmConfig.PcieClkSrcUsage[2] = 0xff;
+		memupd->FspmConfig.PcieClkSrcClkReq[2] = 0xff;
+	}
 }
