diff --git a/src/mainboard/radxa/x4/cfr.c b/src/mainboard/radxa/x4/cfr.c
new file mode 100644
index 00000000..e8dce44b
--- /dev/null
+++ b/src/mainboard/radxa/x4/cfr.c
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <boot/coreboot_tables.h>
+#include <drivers/option/cfr_frontend.h>
+#include <intelblocks/cfr.h>
+#include <soc/cfr.h>
+
+static const struct sm_object emmc_enable = SM_DECLARE_BOOL({
+	.opt_name	= "emmc_enable",
+	.ui_name	= "Onboard eMMC",
+	.ui_helptext	= "Disabled: the eMMC controller is turned off. Neither the"
+			  " firmware nor the OS will see the eMMC.",
+	.default_value	= true,
+});
+
+static const struct sm_object wifi_enable = SM_DECLARE_BOOL({
+	.opt_name	= "wifi_enable",
+	.ui_name	= "Wi-Fi",
+	.ui_helptext	= "Disabled: the Wi-Fi card is turned off and removed from PCI.",
+	.default_value	= true,
+});
+
+static const struct sm_object bt_enable = SM_DECLARE_BOOL({
+	.opt_name	= "bt_enable",
+	.ui_name	= "Bluetooth",
+	.ui_helptext	= "Disabled: the M.2 card's Bluetooth is turned off (W_DISABLE2#).",
+	.default_value	= true,
+});
+
+static const struct sm_object network_stack = SM_DECLARE_BOOL({
+	.opt_name	= "network_stack",
+	.ui_name	= "Network boot",
+	.ui_helptext	= "Disabled: the firmware loads no network driver, so there is no"
+			  " PXE or HTTP boot. The OS still sees the LAN.",
+	.default_value	= false,
+});
+
+static struct sm_obj_form devices = {
+	.ui_name = "Devices",
+	.obj_list = (const struct sm_object *[]) {
+		&emmc_enable,
+		&wifi_enable,
+		&bt_enable,
+		&network_stack,
+		NULL
+	},
+};
+
+static struct sm_obj_form system = {
+	.ui_name = "System",
+	.obj_list = (const struct sm_object *[]) {
+		&vtd,
+		NULL
+	},
+};
+
+/* Read by set_power_limits(). Until EDK2 stores it (first boot), the devicetree applies */
+static const struct sm_object tdp_pl1_override = SM_DECLARE_NUMBER({
+	.opt_name	= "tdp_pl1_override",
+	.ui_name	= "CPU PL1 power limit (W)",
+	.ui_helptext	= "Long-duration package power limit (28 s window). The N100 is"
+			  " rated 6 W; a higher limit sustains turbo for longer.",
+	.default_value	= 13,
+	.min		= 6,
+	.max		= 25,
+	.step		= 1,
+});
+
+static const struct sm_object tdp_pl2_override = SM_DECLARE_NUMBER({
+	.opt_name	= "tdp_pl2_override",
+	.ui_name	= "CPU PL2 power limit (W)",
+	.ui_helptext	= "Short-duration package power limit. Intel's value for the N100"
+			  " is 25 W. Raised to PL1 at boot if lower.",
+	.default_value	= 25,
+	.min		= 6,
+	.max		= 25,
+	.step		= 1,
+});
+
+static struct sm_obj_form power = {
+	.ui_name = "Power",
+	.obj_list = (const struct sm_object *[]) {
+		&tdp_pl1_override,
+		&tdp_pl2_override,
+		&pkg_power_limit_lock,
+		&pciexp_clk_pm,
+		&pciexp_aspm,
+		NULL
+	},
+};
+
+static struct sm_obj_form *sm_root[] = {
+	&devices,
+	&system,
+	&power,
+	NULL
+};
+
+static const struct cfr_default_override x4_cfr_overrides[] = {
+	/* Off, as in the devicetree and the stock firmware */
+	CFR_OVERRIDE_ENUM("pciexp_aspm", ASPM_DISABLE),
+	CFR_OVERRIDE_END
+};
+
+void mb_cfr_setup_menu(struct lb_cfr *cfr_root)
+{
+	cfr_register_overrides(x4_cfr_overrides);
+	cfr_write_setup_menu(cfr_root, sm_root);
+}
diff --git a/src/mainboard/radxa/x4/ramstage.c b/src/mainboard/radxa/x4/ramstage.c
index ea4c9ec3..894d2a51 100644
--- a/src/mainboard/radxa/x4/ramstage.c
+++ b/src/mainboard/radxa/x4/ramstage.c
@@ -1,11 +1,36 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 
+#include <console/console.h>
+#include <device/device.h>
+#include <option.h>
 #include <soc/ramstage.h>
+#include <static.h>
 #include "gpio.h"
 
+/* M.2 W_DISABLE1# (Wi-Fi) and W_DISABLE2# (Bluetooth), driven low to turn the radio off */
+static const struct pad_config wifi_off_pad[] = { PAD_CFG_GPO(GPP_E12, 0, PLTRST) };
+static const struct pad_config bt_off_pad[] = { PAD_CFG_GPO(GPP_A13, 0, DEEP) };
+
 static void mainboard_init(void *chip_info)
 {
 	gpio_configure_pads(gpio_table, ARRAY_SIZE(gpio_table));
+
+	/* Runs before FSP-S; romstage already took root port 4 out of FSP-M */
+	if (!get_uint_option("wifi_enable", 1)) {
+		printk(BIOS_INFO, "Wi-Fi disabled by option\n");
+		gpio_configure_pads(wifi_off_pad, ARRAY_SIZE(wifi_off_pad));
+		DEV_PTR(pcie_rp4)->enabled = 0;
+	}
+	if (!get_uint_option("bt_enable", 1)) {
+		printk(BIOS_INFO, "Bluetooth disabled by option\n");
+		gpio_configure_pads(bt_off_pad, ARRAY_SIZE(bt_off_pad));
+	}
+
+	/* Runs before FSP-S, which takes ScsEmmcEnabled from the devicetree */
+	if (!get_uint_option("emmc_enable", 1)) {
+		printk(BIOS_INFO, "eMMC disabled by option\n");
+		DEV_PTR(emmc)->enabled = 0;
+	}
 }
 
 struct chip_operations mainboard_ops = {
diff --git a/src/mainboard/radxa/x4/romstage.c b/src/mainboard/radxa/x4/romstage.c
index 47d7531d..b3a26b8c 100644
--- a/src/mainboard/radxa/x4/romstage.c
